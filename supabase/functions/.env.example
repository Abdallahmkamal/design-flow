# Hosted Supabase injects its modern key dictionaries. Local Supabase injects
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY instead.
# Keep real values out of Git.
DESIGN_FLOW_ALLOWED_ORIGINS=http://127.0.0.1:5173
DESIGN_FLOW_BOOTSTRAP_EMAIL=first-admin@design-flow.example.invalid
DESIGN_FLOW_BOOTSTRAP_SECRET=replace-with-a-long-one-time-secret
